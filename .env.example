# Copy to .env and adjust (`make env` does it). Never commit the real .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
# Fake payment provider for testing. Forced off by the production compose file.
FAKE_PAYMENTS_ENABLED=true

# --- Auth ---
# Ed25519 key that signs access tokens (base64url of 32 random bytes). Required in prod.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Empty in dev = a new key on every restart (signed-in users just refresh their token).
JWT_SIGNING_KEY=

# --- PostgreSQL ---
# Docker Compose builds DATABASE_URL from the POSTGRES_* values below. Running the backend
# without Docker (cd backend && uvicorn / alembic / python -m app.seed)? Point it at your DB:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/sanad
POSTGRES_USER=sanad
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sanad

# --- Object storage (MinIO in dev, any S3 in prod) ---
MINIO_ROOT_USER=sanad
MINIO_ROOT_PASSWORD=change-me-locally-too

# --- Proxy ---
HTTP_PORT=80
